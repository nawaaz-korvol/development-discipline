{
	"name": "development-discipline",
	"version": "1.0.0",
	"private": true,
	"packageManager": "pnpm@9.12.0",
	"scripts": {
		"prepare": "git config core.hooksPath .githook",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "python -m unittest discover -s tests -v",
		"check:python": "python -m compileall -q scripts tests plugins/development-discipline/skills/codex-claude-review/scripts plugins/development-discipline/skills/codex-claude-review/tests",
		"check": "pnpm check:python && pnpm lint && pnpm test && python scripts/validate_package.py"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4"
	}
}
